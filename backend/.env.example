# Application
APP_NAME=Mental Health Monitoring System
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/mental_health
MONGODB_URL=mongodb://localhost:27017/mental_health_logs

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# AI Models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
SENTIMENT_MODEL=twitter-roberta-base-sentiment
EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
MULTILINGUAL_MODEL=muril-base-cased
VOICE_MODEL=openai/whisper-base

# Feature Weights
SENTIMENT_WEIGHT=0.30
VOICE_WEIGHT=0.25
BEHAVIOR_WEIGHT=0.20
THREAT_WEIGHT=0.15
HISTORY_WEIGHT=0.10

# Alert Thresholds
LOW_RISK_THRESHOLD=30
MEDIUM_RISK_THRESHOLD=60
HIGH_RISK_THRESHOLD=80

# Prediction
PREDICTION_DAYS=7,15,30
PREDICTION_MODEL=xgboost

# Logging
LOG_LEVEL=INFO

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
